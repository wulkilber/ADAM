# Nunca colocar valores reais no GitHub.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
# Produção exige HTTPS, credenciais Google e demonstração desligada.
DEMO_MODE=false
SPREADSHEET_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Conta de serviço com acesso à planilha; caminho local, fora de public/.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
# Alternativa para hospedagem: GOOGLE_SERVICE_ACCOUNT_JSON com JSON completo em segredo.
# Diretório persistente privado; journal de tentativas e trava de instância.
DATA_DIR=./data
# Configure somente após desativar as gravações do Apps Script antigo.
SHEETS_EXCLUSIVE_WRITER=false
# Opcional: domínio institucional; allowlist Usuarios continua obrigatória.
GOOGLE_ALLOWED_DOMAIN=
# Opcional: imagem oficial PNG/JPEG para PDF, caminho local privado.
LOGO_PATH=
